# Secrets and local environment (never commit real credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Local AI assistant instructions: owner-only, never committed. Patterns without a slash
# match at every directory level; both spellings are listed because case sensitivity
# depends on core.ignorecase.
CLAUDE.md
claude.md

# Java / Maven (module-specific rules live in services/sentinel-api/.gitignore)
target/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# IDEs and editors
.idea/
*.iml
.vscode/

# Test diagnostics written on broker startup failures (may contain container logs)
.test-diagnostics/

# Worker runtime state (durable processing receipts)
.sentinel-worker/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Downloaded CI log archives and local logs/temporary files
logs_*.zip
*.log
tmp/

# OS files
.DS_Store
Thumbs.db
desktop.ini
