# SentinelPipe local development environment.
#
# DEVELOPMENT-ONLY PLACEHOLDERS. Copy this file to `.env` and replace every
# `dev-only-change-me` value with a locally generated random secret.
# `.env` is git-ignored and must never be committed. Never reuse these values
# outside a local workstation or an ephemeral CI job. Passwords must not start with "-"
# (rabbitmqctl would parse them as options).
#
# After `docker compose up`, create the least-privileged runtime identities once with
# scripts/dev/provision.ps1 (Windows) or scripts/dev/provision.sh (see README).

# --- PostgreSQL ---
# Cluster administrator (Docker Compose POSTGRES_USER): provisioning ONLY, never a service.
# Installations created before M3 used SENTINEL_DB_USERNAME/SENTINEL_DB_PASSWORD for this
# account; move those values here (see docs/runbooks/database-roles.md).
SENTINEL_DB_ADMIN_USERNAME=sentinel
SENTINEL_DB_ADMIN_PASSWORD=dev-only-change-me
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinelpipe
# sentinel-api runtime login (member of sentinel_api: DML only, no DDL).
SENTINEL_DB_USERNAME=sentinel_api_app
SENTINEL_DB_PASSWORD=dev-only-change-me
# Flyway login (may only SET ROLE sentinel_owner, the non-superuser schema owner).
SENTINEL_DB_MIGRATION_USERNAME=sentinel_migrator_app
SENTINEL_DB_MIGRATION_PASSWORD=dev-only-change-me

# --- RabbitMQ broker administrator (Docker Compose; provisioning ONLY, never a service) ---
SENTINEL_RABBITMQ_ADMIN_USERNAME=sentinel-admin
SENTINEL_RABBITMQ_ADMIN_PASSWORD=dev-only-change-me
SENTINEL_RABBITMQ_PORT=5672
SENTINEL_RABBITMQ_MANAGEMENT_PORT=15672

# --- RabbitMQ publisher (sentinel-api runtime; write sentinel.scan-requests only) ---
SENTINEL_RABBITMQ_HOST=localhost
SENTINEL_RABBITMQ_USERNAME=sentinel-publisher
SENTINEL_RABBITMQ_PASSWORD=dev-only-change-me
SENTINEL_RABBITMQ_VHOST=/
# Same identity, as read by the provisioning script.
SENTINEL_RABBITMQ_PUBLISHER_USERNAME=sentinel-publisher
SENTINEL_RABBITMQ_PUBLISHER_PASSWORD=dev-only-change-me

# --- Open Policy Agent (Docker Compose) ---
SENTINEL_OPA_PORT=8181

# --- sentinel-worker ---
# The worker's OWN least-privileged broker user (read its queue, write to the retry and
# dead-letter exchanges only), created by the provisioning script.
SENTINEL_WORKER_RABBITMQ_HOST=localhost
SENTINEL_WORKER_RABBITMQ_PORT=5672
SENTINEL_WORKER_RABBITMQ_USERNAME=sentinel-worker
SENTINEL_WORKER_RABBITMQ_PASSWORD=dev-only-change-me
# Receipt store: `postgres` (default; shared, verified against the control plane) or
# `sqlite` (development only: single host, no tenant verification).
SENTINEL_WORKER_RECEIPT_BACKEND=postgres
# The worker's OWN PostgreSQL login role (member of sentinel_worker: EXECUTE
# worker.record_receipt only), created by the provisioning script.
SENTINEL_WORKER_DB_HOST=localhost
SENTINEL_WORKER_DB_PORT=5432
SENTINEL_WORKER_DB_NAME=sentinelpipe
SENTINEL_WORKER_DB_USERNAME=sentinel_worker_app
SENTINEL_WORKER_DB_PASSWORD=dev-only-change-me
# disable|allow|prefer|require|verify-ca|verify-full (production requires verify-ca/full).
SENTINEL_WORKER_DB_SSLMODE=prefer
# Only for SENTINEL_WORKER_RECEIPT_BACKEND=sqlite.
SENTINEL_WORKER_RECEIPT_DB=.sentinel-worker/receipts.sqlite3
# Prometheus exposition; disabled unless a port is set. Loopback addresses only.
# SENTINEL_WORKER_METRICS_PORT=9465
# SENTINEL_WORKER_METRICS_ADDRESS=127.0.0.1
# One of: development, ci, production
SENTINEL_WORKER_ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENTINEL_WORKER_LOG_LEVEL=INFO
# Job execution (sentinel-worker execute, ADR-0007). Only the harmless FIXTURE executor
# exists; it is refused in production. The API side is configured with
# SENTINEL_EXECUTION_FIXTURE_ENABLED / SENTINEL_EXECUTION_PLANNED_SCANNERS (both off by default).
# SENTINEL_WORKER_FIXTURE_ENABLED=true
# SENTINEL_WORKER_FIXTURE_SECONDS=2
# SENTINEL_WORKER_EXECUTION_POLL_SECONDS=5
# The fixture runs in a sandbox container by default (ADR-0009); pull the pinned image first:
#   docker pull alpine@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
# SENTINEL_WORKER_FIXTURE_EXECUTOR=sandbox
# SENTINEL_WORKER_FIXTURE_MODE=success
# SENTINEL_WORKER_SANDBOX_TIMEOUT_SECONDS=300
# SENTINEL_WORKER_SANDBOX_MEMORY_MB=256
# SENTINEL_WORKER_SANDBOX_CPUS=1
# SENTINEL_WORKER_SANDBOX_PIDS=64
# SENTINEL_WORKER_SANDBOX_RUNTIME=

# --- Operator recovery tools (sentinel-worker outbox-*/dlq-* commands) ---
# Issue these credentials only to on-call operators. Broker: read the dead-letter queue,
# write sentinel.scan-requests. Database: EXECUTE the audited ops.* functions only.
# Leave the passwords empty to skip creating the operator identities.
SENTINEL_OPERATOR_RABBITMQ_HOST=localhost
SENTINEL_OPERATOR_RABBITMQ_PORT=5672
SENTINEL_OPERATOR_RABBITMQ_USERNAME=sentinel-operator
SENTINEL_OPERATOR_RABBITMQ_PASSWORD=dev-only-change-me
SENTINEL_OPERATOR_DB_HOST=localhost
SENTINEL_OPERATOR_DB_PORT=5432
SENTINEL_OPERATOR_DB_NAME=sentinelpipe
SENTINEL_OPERATOR_DB_USERNAME=sentinel_operator_app
SENTINEL_OPERATOR_DB_PASSWORD=dev-only-change-me

# --- sentinel-api identity (M2 Phase 2A) ---
# Required only when the domain API is enabled (`local` profile). These are NOT secrets:
# they describe your OIDC provider and its public signing keys. Uncomment and set them
# to your provider's values (see README, "Identity provider setup").
# SENTINEL_SECURITY_JWT_ISSUER=https://idp.example.com/realms/sentinel
# SENTINEL_SECURITY_JWT_AUDIENCE=sentinel-api
# SENTINEL_SECURITY_JWT_JWK_SET_URI=https://idp.example.com/realms/sentinel/protocol/openid-connect/certs
# Comma-separated token subjects allowed to create organizations (bootstrap only).
# SENTINEL_SECURITY_PLATFORM_ADMIN_SUBJECTS=
