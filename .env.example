# SentinelPipe local development environment.
#
# DEVELOPMENT-ONLY PLACEHOLDERS. Copy this file to `.env` and replace every
# `dev-only-change-me` value with a locally generated random secret.
# `.env` is git-ignored and must never be committed. Never reuse these values
# outside a local workstation or an ephemeral CI job.

# --- PostgreSQL (Docker Compose + sentinel-api) ---
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinelpipe
SENTINEL_DB_USERNAME=sentinel
SENTINEL_DB_PASSWORD=dev-only-change-me

# --- RabbitMQ (Docker Compose + sentinel-api) ---
SENTINEL_RABBITMQ_HOST=localhost
SENTINEL_RABBITMQ_PORT=5672
SENTINEL_RABBITMQ_MANAGEMENT_PORT=15672
SENTINEL_RABBITMQ_USERNAME=sentinel
SENTINEL_RABBITMQ_PASSWORD=dev-only-change-me
SENTINEL_RABBITMQ_VHOST=/

# --- Open Policy Agent (Docker Compose) ---
SENTINEL_OPA_PORT=8181

# --- sentinel-worker ---
# The worker's OWN least-privileged broker user (read its queue, write to the retry and
# dead-letter exchanges only). Create it as described in docs/runbooks/messaging.md.
SENTINEL_WORKER_RABBITMQ_HOST=localhost
SENTINEL_WORKER_RABBITMQ_PORT=5672
SENTINEL_WORKER_RABBITMQ_USERNAME=sentinel-worker
SENTINEL_WORKER_RABBITMQ_PASSWORD=dev-only-change-me
SENTINEL_WORKER_RECEIPT_DB=.sentinel-worker/receipts.sqlite3
# One of: development, ci, production
SENTINEL_WORKER_ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENTINEL_WORKER_LOG_LEVEL=INFO

# --- sentinel-api identity (M2 Phase 2A) ---
# Required only when the domain API is enabled (`local` profile). These are NOT secrets:
# they describe your OIDC provider and its public signing keys. Uncomment and set them
# to your provider's values (see README, "Identity provider setup").
# SENTINEL_SECURITY_JWT_ISSUER=https://idp.example.com/realms/sentinel
# SENTINEL_SECURITY_JWT_AUDIENCE=sentinel-api
# SENTINEL_SECURITY_JWT_JWK_SET_URI=https://idp.example.com/realms/sentinel/protocol/openid-connect/certs
# Comma-separated token subjects allowed to create organizations (bootstrap only).
# SENTINEL_SECURITY_PLATFORM_ADMIN_SUBJECTS=
