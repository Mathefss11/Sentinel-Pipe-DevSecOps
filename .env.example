# SentinelPipe local development environment.
#
# DEVELOPMENT-ONLY PLACEHOLDERS. Copy this file to `.env` and replace every
# `dev-only-change-me` value with a locally generated random secret.
# `.env` is git-ignored and must never be committed. Never reuse these values
# outside a local workstation or an ephemeral CI job.

# --- PostgreSQL (Docker Compose + sentinel-api) ---
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinelpipe
SENTINEL_DB_USERNAME=sentinel
SENTINEL_DB_PASSWORD=dev-only-change-me

# --- RabbitMQ (Docker Compose + sentinel-api) ---
SENTINEL_RABBITMQ_HOST=localhost
SENTINEL_RABBITMQ_PORT=5672
SENTINEL_RABBITMQ_MANAGEMENT_PORT=15672
SENTINEL_RABBITMQ_USERNAME=sentinel
SENTINEL_RABBITMQ_PASSWORD=dev-only-change-me
SENTINEL_RABBITMQ_VHOST=/

# --- Open Policy Agent (Docker Compose) ---
SENTINEL_OPA_PORT=8181

# --- sentinel-worker ---
# One of: development, ci, production
SENTINEL_WORKER_ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
SENTINEL_WORKER_LOG_LEVEL=INFO
