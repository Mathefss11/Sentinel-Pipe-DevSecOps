{
  "exchanges": [
    {
      "name": "sentinel.scan-requests",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "sentinel.scan-requests.dlx",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "sentinel.scan-requests.retry",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "sentinel.scan-requests.worker",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 5,
        "x-dead-letter-exchange": "sentinel.scan-requests.dlx",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish",
        "x-max-length": 100000
      }
    },
    {
      "name": "sentinel.scan-requests.dead-letter",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "sentinel.scan-requests.retry",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 15000,
        "x-dead-letter-exchange": "sentinel.scan-requests",
        "x-dead-letter-routing-key": "scan.requested.v1",
        "x-dead-letter-strategy": "at-least-once",
        "x-overflow": "reject-publish",
        "x-max-length": 100000
      }
    }
  ],
  "bindings": [
    {
      "source": "sentinel.scan-requests",
      "vhost": "/",
      "destination": "sentinel.scan-requests.worker",
      "destination_type": "queue",
      "routing_key": "scan.requested.v1",
      "arguments": {}
    },
    {
      "source": "sentinel.scan-requests.dlx",
      "vhost": "/",
      "destination": "sentinel.scan-requests.dead-letter",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "sentinel.scan-requests.retry",
      "vhost": "/",
      "destination": "sentinel.scan-requests.retry",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "sentinel-dead-letter-retention",
      "pattern": "^sentinel\\.scan-requests\\.dead-letter$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "delivery-limit": -1
      }
    }
  ]
}
