{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelpipe.dev/schemas/messages/v1/job-result.v1.schema.json",
  "title": "Scan job result v1",
  "description": "Result of one leased scan job, submitted by the worker with worker.submit_result (ADR-0008). Every identifier is a claim that PostgreSQL checks against the authoritative job, scan, project and organization; the lease token is passed separately and never appears here. Artifact digests are checked against the digests PostgreSQL computed from the uploaded bytes; a digest in this document is never proof on its own. COMPLETED means the scanner ran and produced its output; it says nothing about findings or the security decision. Serialization: canonical JSON (UTF-8, ASCII only, object keys sorted by code point, no insignificant whitespace, no duplicate keys, integers only, artifacts sorted by name), at most 16384 bytes. The exact bytes identify the result: resubmitting the same bytes is idempotent, different bytes for the same lease are a conflict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "scan_id",
    "project_id",
    "organization_id",
    "commit_sha",
    "scanner_type",
    "attempt",
    "lease_epoch",
    "outcome",
    "failure_reason",
    "started_at",
    "finished_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract version. Any other value is rejected (REJECTED_UNSUPPORTED_SCHEMA_VERSION).",
      "const": 1
    },
    "job_id": { "$ref": "#/$defs/uuid" },
    "scan_id": { "$ref": "#/$defs/uuid" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "organization_id": { "$ref": "#/$defs/uuid" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "scanner_type": {
      "type": "string",
      "enum": ["SEMGREP", "GITLEAKS", "TRIVY", "CHECKOV", "SYFT", "ZAP", "FIXTURE"]
    },
    "attempt": { "description": "Attempt number of the lease (1-3).", "type": "integer", "minimum": 1, "maximum": 3 },
    "lease_epoch": {
      "description": "Fencing epoch returned by worker.claim_job.",
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999
    },
    "outcome": { "type": "string", "enum": ["COMPLETED", "FAILED"] },
    "failure_reason": {
      "description": "null for COMPLETED; required for FAILED. Retries are decided by the control plane.",
      "enum": [
        null,
        "SCANNER_ERROR",
        "SANDBOX_ERROR",
        "WORKER_SHUTDOWN",
        "EVIDENCE_UNAVAILABLE",
        "EXECUTION_TIMEOUT",
        "RESOURCE_LIMIT_EXCEEDED",
        "UNSUPPORTED_SCANNER"
      ]
    },
    "started_at": {
      "description": "Worker clock, UTC, informational (lease expiry and deadlines use the database clock).",
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": { "description": "Worker clock, UTC; not before started_at.", "$ref": "#/$defs/timestamp" },
    "artifacts": {
      "description": "Evidence uploaded with worker.put_evidence under the same lease, sorted by name, names unique.",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "COMPLETED" } } },
      "then": { "properties": { "failure_reason": { "const": null } } },
      "else": { "properties": { "failure_reason": { "type": "string" } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "size_bytes", "sha256"],
      "properties": {
        "name": {
          "description": "Restricted identifier, never a path or URL.",
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "media_type": { "type": "string", "enum": ["application/json", "application/sarif+json", "text/plain"] },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "examples": [
    {
      "artifacts": [
        {
          "media_type": "application/json",
          "name": "fixture-result.json",
          "sha256": "4062edaf750fb8074e7e83e0c9028c94e32468a8b6f1614774328ef045150f93",
          "size_bytes": 11
        }
      ],
      "attempt": 1,
      "commit_sha": "4f2c8e1d9b7a6c5e3f1a2b4c6d8e0f1a3b5c7d9e",
      "failure_reason": null,
      "finished_at": "2026-10-10T12:00:02.250000Z",
      "job_id": "3c5e7a9b-0d1f-4e2a-9b3c-5d7e9f1a3b5c",
      "lease_epoch": 1,
      "organization_id": "0b8f6a0e-6f2b-4d55-9a8b-2c0c4b3f1d10",
      "outcome": "COMPLETED",
      "project_id": "6d1f0a52-3c1e-4b8e-8f0e-1a2b3c4d5e6f",
      "scan_id": "9a7e5c3b-1d2f-4a6b-8c0d-2e4f6a8b0c1d",
      "scanner_type": "FIXTURE",
      "schema_version": 1,
      "started_at": "2026-10-10T12:00:00Z"
    },
    {
      "artifacts": [],
      "attempt": 2,
      "commit_sha": "4f2c8e1d9b7a6c5e3f1a2b4c6d8e0f1a3b5c7d9e",
      "failure_reason": "SANDBOX_ERROR",
      "finished_at": "2026-10-10T12:01:00Z",
      "job_id": "3c5e7a9b-0d1f-4e2a-9b3c-5d7e9f1a3b5c",
      "lease_epoch": 2,
      "organization_id": "0b8f6a0e-6f2b-4d55-9a8b-2c0c4b3f1d10",
      "outcome": "FAILED",
      "project_id": "6d1f0a52-3c1e-4b8e-8f0e-1a2b3c4d5e6f",
      "scan_id": "9a7e5c3b-1d2f-4a6b-8c0d-2e4f6a8b0c1d",
      "scanner_type": "FIXTURE",
      "schema_version": 1,
      "started_at": "2026-10-10T12:00:30Z"
    }
  ]
}
