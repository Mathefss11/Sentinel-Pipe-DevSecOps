{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinelpipe.dev/schemas/v1/scan-job.schema.json",
  "title": "ScanJob",
  "description": "One scanner execution within a scan. COMPLETED means the scanner produced its output; it says nothing about findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scanId",
    "scannerType",
    "executionStatus",
    "attemptCount",
    "createdAt",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "scanId": { "$ref": "common.schema.json#/$defs/uuid" },
    "scannerType": {
      "type": "string",
      "enum": ["SEMGREP", "GITLEAKS", "TRIVY", "CHECKOV", "SYFT", "ZAP"]
    },
    "executionStatus": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "attemptCount": { "type": "integer", "minimum": 0, "maximum": 3 },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "startedAt": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
    "completedAt": { "$ref": "common.schema.json#/$defs/nullableTimestamp" }
  }
}
